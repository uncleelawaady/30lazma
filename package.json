{
  "name": "elawaady-xdigital-store",
  "version": "0.1.0",
  "private": true,
  "description": "Elawaady XDigital (Elwaset) storefront — static site + Firebase rules and tests",
  "scripts": {
    "serve": "python3 -m http.server 8777 --bind 127.0.0.1",
    "test:rules": "firebase emulators:exec --only firestore,storage --project elwaset-test \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test": "npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.29.1",
    "playwright": "^1.49.0"
  }
}
