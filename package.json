{
  "name": "newlynow-store",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-newlynow.mjs",
    "test:theme": "node scripts/validate-theme.mjs",
    "test:pricing": "node --test tests/pricing.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-newlynow \"node --test tests/firestore.rules.test.mjs\"",
    "test": "npm run validate && npm run test:theme && npm run test:pricing && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0"
  }
}
