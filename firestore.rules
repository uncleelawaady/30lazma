rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner() {
      return signedIn()
        && request.auth.token.email in [
          'elawaady.official@gmail.com',
          'elawadi.store4@gmail.com'
        ];
    }

    function adminList() {
      return exists(/databases/$(database)/documents/config/site)
        ? get(/databases/$(database)/documents/config/site).data.get('admins', [])
        : [];
    }

    function isAdmin() {
      return owner() || (signedIn() && request.auth.token.email in adminList());
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function validReview() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name','email','phone','uid','photo','source','provider',
          'rating','text','approved','createdAt'
        ])
        && d.keys().hasAll(['name','rating','text','approved','createdAt'])
        && shortString(d.name, 120)
        && shortString(d.get('email', ''), 254)
        && shortString(d.get('phone', ''), 40)
        && shortString(d.get('uid', ''), 128)
        && shortString(d.get('photo', ''), 2000)
        && shortString(d.get('source', ''), 40)
        && shortString(d.get('provider', ''), 40)
        && d.rating >= 1 && d.rating <= 5
        && shortString(d.text, 5000)
        && d.approved == false
        && d.createdAt == request.time;
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'orderNo','name','phone','notes','items','count','status',
          'paymentStatus','paymentMethod','paymentAttemptId','source','createdAt'
        ])
        && d.keys().hasAll([
          'orderNo','name','phone','items','count','status',
          'paymentStatus','paymentMethod','paymentAttemptId','source','createdAt'
        ])
        && shortString(d.orderNo, 48)
        && d.orderNo.size() >= 3
        && shortString(d.name, 120)
        && d.name.size() >= 1
        && shortString(d.phone, 40)
        && d.phone.size() >= 4
        && shortString(d.get('notes', ''), 3000)
        && d.items is list
        && d.items.size() > 0 && d.items.size() <= 50
        && d.count >= 1 && d.count <= 5000000
        && d.status == 'new'
        && d.paymentStatus == 'unpaid'
        && d.paymentMethod == ''
        && d.paymentAttemptId == ''
        && d.source == 'store'
        && d.createdAt == request.time;
    }

    function validPaymentAttempt() {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(d.orderId);
      return d.keys().hasOnly([
          'orderId','orderNo','methodId','methodName','type','status','reference','createdAt'
        ])
        && d.keys().hasAll([
          'orderId','orderNo','methodId','methodName','type','status','reference','createdAt'
        ])
        && shortString(d.orderId, 128)
        && d.orderId.size() >= 1
        && shortString(d.orderNo, 48)
        && d.orderNo.size() >= 3
        && shortString(d.methodId, 80)
        && d.methodId.size() >= 1
        && shortString(d.methodName, 120)
        && d.methodName.size() >= 1
        && d.type in ['manual', 'automatic']
        && ((d.type == 'manual' && d.status == 'pending_verification')
          || (d.type == 'automatic' && d.status == 'initiated'))
        && shortString(d.reference, 160)
        && d.createdAt == request.time
        && exists(orderPath)
        && get(orderPath).data.orderNo == d.orderNo;
    }

    function validCustomer() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name','email','phone','uid','photo','source','provider','type',
          'createdAt','updatedAt','lastSeen'
        ])
        && shortString(d.get('name', ''), 120)
        && shortString(d.get('email', ''), 254)
        && shortString(d.get('phone', ''), 40)
        && shortString(d.get('uid', ''), 128)
        && shortString(d.get('photo', ''), 2000)
        && shortString(d.get('source', ''), 40)
        && shortString(d.get('provider', ''), 40)
        && shortString(d.get('type', ''), 40);
    }

    function validUser(id) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name','email','phone','uid','photo','provider','type',
          'createdAt','lastSeen'
        ])
        && d.get('uid', id) == id
        && shortString(d.get('name', ''), 120)
        && shortString(d.get('email', ''), 254)
        && shortString(d.get('phone', ''), 40)
        && shortString(d.get('photo', ''), 2000)
        && shortString(d.get('provider', ''), 40)
        && shortString(d.get('type', ''), 40);
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if validReview();
      allow update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    match /paymentAttempts/{id} {
      allow create: if validPaymentAttempt();
      allow read, update, delete: if isAdmin();
    }

    match /customers/{id} {
      allow create: if validCustomer();
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == id && validCustomer());
      allow delete: if isAdmin();
    }

    match /users/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == id && validUser(id));
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
