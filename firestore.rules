rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permanent owners (full control, can manage admins).
    function owner() {
      return request.auth != null
        && request.auth.token.email in [
          'elawaady.official@gmail.com',
          'elawadi.store4@gmail.com'
        ];
    }

    // Safe read of the admins list (never errors if the field/doc is missing).
    function adminList() {
      return exists(/databases/$(database)/documents/config/site)
        ? get(/databases/$(database)/documents/config/site).data.get('admins', [])
        : [];
    }

    // Owner OR any email listed in config/site.admins can manage the store.
    function isAdmin() {
      return owner() || (request.auth != null && request.auth.token.email in adminList());
    }

    // Site config: theme, texts, catalog, policies, admins, ticker...
    // Public read (the storefront needs it). Admins can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: visitors submit (pending), admins moderate.
    match /reviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders: visitors create at checkout, admins read/manage.
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customers: created at checkout/registration; admins read/manage;
    // a signed-in user can write their own doc.
    match /customers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == id;
    }

    // Users (accounts): the user manages their own doc, admins can read.
    match /users/{id} {
      allow read: if isAdmin();
      allow write: if request.auth != null && (request.auth.uid == id || isAdmin());
    }

    // Announcements (notifications): public read, admins write.
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
