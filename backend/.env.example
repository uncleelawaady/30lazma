# Copy to .env beside passenger_wsgi.py, or set these under
# cPanel -> Setup Python App -> Environment variables.
# NEVER commit the real .env.

APP_ENV=production
APP_DEBUG=0
APP_VERSION=0.1.0

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Comma-separated. The storefront origins allowed to call this API.
CORS_ORIGINS=https://newlynow.com,https://www.newlynow.com,https://e-network.net

# Turn on only while diagnosing a failed boot, then remove.
APP_BOOT_DIAGNOSTICS=0
