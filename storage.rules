rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function owner() {
      return signedIn()
        && request.auth.token.email in [
          'elawaady.official@gmail.com',
          'elawadi.store4@gmail.com'
        ];
    }

    // Storage rules can read Firestore, so the admin list stays in one place
    // instead of being duplicated (and going stale) here.
    function adminEmails() {
      return firestore.exists(/databases/(default)/documents/config/admins)
        ? firestore.get(/databases/(default)/documents/config/admins).data.get('emails', [])
        : [];
    }

    function isAdmin() {
      return owner() || (signedIn() && request.auth.token.email in adminEmails());
    }

    // Public storefront media. `categories/` and `services/` are the folders the
    // existing admin uploader already writes to — keep them working.
    function publicMediaFolder(f) {
      return f in ['store', 'categories', 'services', 'banners', 'media', 'proofs-public'];
    }

    // ---- upload validation (size + content type) --------------------------

    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|avif|svg\\+xml)');
    }

    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---- private: customer payment / order proofs -------------------------
    // Declared before the generic media rule and deliberately NOT in
    // publicMediaFolder(), so a receipt is never readable by URL guessing.
    match /proofs/{uid}/{fileName} {
      allow read:   if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write:  if signedIn()
                    && request.auth.uid == uid
                    && (isImage() || request.resource.contentType == 'application/pdf')
                    && underSize(5);
      allow delete: if isAdmin();
    }

    // ---- public storefront media -----------------------------------------
    match /{folder}/{allPaths=**} {
      allow read:   if publicMediaFolder(folder);
      allow write:  if isAdmin() && publicMediaFolder(folder) && isImage() && underSize(5);
      allow delete: if isAdmin() && publicMediaFolder(folder);
    }

    // ---- everything else --------------------------------------------------
    // Legacy objects sitting at the bucket root stay readable so nothing that
    // renders today breaks, but nothing new can be written outside the folders
    // above. This replaces the old `match /{allPaths=**} { allow write }`
    // catch-all, which accepted uploads of any size and any content type.
    match /{fileName} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
