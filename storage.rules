rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Everyone can view store images; only the owner can upload/replace them.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'elawaady.official@gmail.com';
    }
  }
}
